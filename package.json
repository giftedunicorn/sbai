{
  "name": "ganagent",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "description": "A local-first pixel companion for blowing off steam at AI coding agents without interrupting their work.",
  "license": "MIT",
  "homepage": "https://github.com/giftedunicorn/sbai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giftedunicorn/sbai.git"
  },
  "bugs": {
    "url": "https://github.com/giftedunicorn/sbai/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "electron",
    "local-first",
    "phaser",
    "pixel-art",
    "privacy"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -p tsconfig.json && npm run build:web && npm run build:electron",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "jsdom": "^30.0.1"
  }
}
